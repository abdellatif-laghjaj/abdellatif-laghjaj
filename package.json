{
  "name": "commit-city",
  "version": "1.0.0",
  "private": true,
  "description": "A night-time New York built from a GitHub contribution graph, rendered to a looping image for a profile README.",
  "type": "module",
  "scripts": {
    "data:demo": "node scripts/synthetic.mjs",
    "data": "node scripts/fetch.mjs",
    "render": "python scripts/render.py --frames 150 --out out/frames",
    "assemble": "python scripts/assemble.py --fps 15",
    "preview": "python -m http.server 8080"
  },
  "dependencies": {
    "three": "0.170.0"
  }
}
